# ===========================================
# EventCraft AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# --- Database (Supabase) ---
# Use sqlite for a zero-credential local demo. Change to supabase for hosted persistence.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/eventcraft.sqlite
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI ---
# Use "ollama" or "lmstudio" for free local models with no API key.
# Use "local" for the built-in deterministic starter mode.
# Ollama example: ollama pull llama3.2:3b
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=llama3.2:3b
LOCAL_AI_TIMEOUT_MS=45000

# Gemini is optional and remains server-side.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Server & Deployment ---
PORT=3001
NODE_ENV=production
# Keep false for zero-config demo mode; set true when Supabase JWT auth is configured.
AUTH_ENABLED=false
# Optional: Comma-separated allowed CORS origins (defaults to same-origin in production).
CORS_ORIGINS=https://your-domain.vercel.app

# --- Frontend (Optional) ---
# If hosting the backend separately (e.g. Render/Railway), set this in Vercel environment variables.
# Leave blank or omit when using Vercel Serverless Functions on the same domain.
VITE_API_BASE_URL=
