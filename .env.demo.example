# Controlled portfolio/evaluator demo. Do not use for shared multi-user production.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/eventcraft.sqlite
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=llama3.2:3b
LOCAL_AI_TIMEOUT_MS=45000
PORT=3001
NODE_ENV=production
DEMO_MODE=true
AUTH_ENABLED=false
DEMO_ALLOW_CLIENT_SESSION_ID=false
DISABLE_PRODUCTION_API=false
TRUST_PROXY=false
CORS_ORIGINS=https://your-domain.example
